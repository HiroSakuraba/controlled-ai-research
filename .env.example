# Copy to .env locally. Never commit keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pinned. Any other value is rejected by ProviderConfig.
CONTROLLED_AI_OPENAI_MODEL=gpt-5.6-luna
CONTROLLED_AI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Leave unset until the dry-run is checked.
# CONTROLLED_AI_ENABLE_NETWORK=1
# CONTROLLED_AI_VALIDATE_PROVIDER_WIRE=1
